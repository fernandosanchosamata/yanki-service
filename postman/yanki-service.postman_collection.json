{
  "info": {
    "_postman_id": "2c6e5b2f-1bb5-4d6b-9b53-yanki-service",
    "name": "NTT Bootcamp - Yanki Service via API Gateway",
    "description": "Collection para probar yanki-service a traves de api-gateway. Ejecutar primero Auth / Login - Admin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "source_phone",
      "value": "999111222"
    },
    {
      "key": "target_phone",
      "value": "999333444"
    },
    {
      "key": "card_number",
      "value": "4555-6666-7777-8888"
    },
    {
      "key": "amount",
      "value": "25.00"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login exitoso', function () { pm.response.to.have.status(200); });",
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set('access_token', response.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/auth-service/auth/login",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "auth-service",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Yanki",
      "item": [
        {
          "name": "Create Source Wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentType\": \"DNI\",\n  \"documentNumber\": \"12345678\",\n  \"phoneNumber\": \"{{source_phone}}\",\n  \"imei\": \"356938035643809\",\n  \"email\": \"source.wallet@example.com\",\n  \"associatedDebitCard\": \"{{card_number}}\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/yanki-service/api/v1/yanki/wallets",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "yanki-service",
                "api",
                "v1",
                "yanki",
                "wallets"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Target Wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentType\": \"DNI\",\n  \"documentNumber\": \"87654321\",\n  \"phoneNumber\": \"{{target_phone}}\",\n  \"imei\": \"356938035643810\",\n  \"email\": \"target.wallet@example.com\",\n  \"associatedDebitCard\": null\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/yanki-service/api/v1/yanki/wallets",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "yanki-service",
                "api",
                "v1",
                "yanki",
                "wallets"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Wallet By Phone",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/yanki-service/api/v1/yanki/wallets/{{source_phone}}",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "yanki-service",
                "api",
                "v1",
                "yanki",
                "wallets",
                "{{source_phone}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Execute Transaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourcePhoneNumber\": \"{{source_phone}}\",\n  \"targetPhoneNumber\": \"{{target_phone}}\",\n  \"amount\": {{amount}}\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/yanki-service/api/v1/yanki/transactions",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "yanki-service",
                "api",
                "v1",
                "yanki",
                "transactions"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
