        </mxCell>
        <mxCell id="note" value="Flujo principal: el cliente obtiene JWT, ejecuta una transferencia Yanki por numero celular, se consultan wallets origen/destino, se descuenta/deposita en wallet o cuenta bancaria asociada, se guarda la transaccion y se publica evento Kafka." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="40" y="60" width="1020" height="50" as="geometry" />
        </mxCell>
