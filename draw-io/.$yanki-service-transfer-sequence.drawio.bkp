        <mxCell id="m1" value="1. POST /auth-service/auth/login" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105" y="215" as="sourcePoint" /><mxPoint x="275" y="215" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="2. JWT accessToken" style="endArrow=open;html=1;rounded=0;dashed=1;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="275" y="250" as="sourcePoint" /><mxPoint x="105" y="250" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m3" value="3. POST /yanki-service/api/v1/yanki/transactions" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105" y="300" as="sourcePoint" /><mxPoint x="445" y="300" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m4" value="4. Validar JWT y reenviar" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="445" y="345" as="sourcePoint" /><mxPoint x="620" y="345" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m5" value="5. Buscar wallet origen por celular" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="390" as="sourcePoint" /><mxPoint x="810" y="390" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m6" value="6. Buscar wallet destino por celular" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="435" as="sourcePoint" /><mxPoint x="810" y="435" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m7" value="7. Guardar YankiTransaction PROCESSING" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="480" as="sourcePoint" /><mxPoint x="810" y="480" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m8" value="8. Descontar origen&lt;br&gt;wallet local o cuenta asociada" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="525" as="sourcePoint" /><mxPoint x="1000" y="525" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m9" value="9. Depositar destino&lt;br&gt;wallet local o cuenta asociada" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="580" as="sourcePoint" /><mxPoint x="1000" y="580" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m10" value="10. Actualizar transaccion COMPLETED" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="635" as="sourcePoint" /><mxPoint x="810" y="635" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m11" value="11. Publicar evento YANKI_TRANSFER" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="690" as="sourcePoint" /><mxPoint x="1200" y="690" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m12" value="12. 201 Created + YankiTransaction" style="endArrow=open;html=1;rounded=0;dashed=1;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="750" as="sourcePoint" /><mxPoint x="105" y="750" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="errorNote" value="Errores esperados: celular origen/destino no registrado, saldo Yanki insuficiente, cuenta bancaria asociada no disponible. Si falla una etapa, la transaccion queda FAILED." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacing=10;" parent="1" vertex="1">
