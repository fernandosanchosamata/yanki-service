        <mxCell id="title" value="yanki-service - Secuencia: transferencia entre monederos via API Gateway" style="text;html=1;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
